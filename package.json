{
  "name": "tripflow-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test": "tsc -p tsconfig.api.json && tsc -p tsconfig.data-test.json && node --import ./scripts/register-ts-import-resolve.mjs --experimental-strip-types --experimental-test-module-mocks --test api/*.test.ts api/_lib/*.test.ts src/data/*.test.ts src/stores/*.test.ts src/composables/*.test.ts",
    "test:components": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@vueuse/core": "^14.3.0",
    "dayjs": "^1.11.21",
    "leaflet": "^1.9.4",
    "nanoid": "^5.1.16",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.11.1",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  }
}
