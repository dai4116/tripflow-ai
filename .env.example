# Server-side only — read by api/plan-trip-zones.ts and api/generate-trip-day.ts
# (per-day trip generation, one serverless invocation per day) and api/ask-ai.ts
# (AskAiPanel). NEVER prefix this with VITE_: that would bundle it into the
# client-side JS, exposing it to anyone who opens DevTools.
ANTHROPIC_API_KEY=

# Server-side only — read by api/route.ts (proxies OpenRouteService so the
# key never reaches the browser). Free token from openrouteservice.org/dev.
OPENROUTESERVICE_API_KEY=

# Server-side only — read by api/plan-trip-zones.ts and api/generate-trip-day.ts
# (via api/_lib/placesVerify.ts) for generation-time verification, plus
# api/places-search.ts, api/places-autocomplete.ts, api/place-details.ts,
# api/place-photo.ts, api/place-cover-photos.ts and api/geocode-destination.ts
# for manual place search/autocomplete/photos. Google Places API (New) key.
# When set, every AI-suggested place is verified against Google Places at
# generation time (region-locked to the destination) and only real, findable
# places make it onto the map, with coordinates from Google. When UNSET,
# generation still works but falls back to the old client-side Nominatim
# geocoding (some places may not pin / may pin wrong).
# Setup: Google Cloud project -> enable "Places API (New)" -> create an API
# key -> enable billing (required even for the free tier). Recommend setting a
# quota cap so usage hard-stops at the free tier (5,000 Text Search Pro
# calls/month) and can never be charged. NEVER prefix with VITE_.
GOOGLE_PLACES_API_KEY=

# Server-side only — read by api/_lib/placesVerify.ts. Upstash Redis (via
# Vercel Marketplace's "Upstash for Redis" integration), used as a
# cross-invocation cache for Google Places verification results — a single
# trip generation fans out across many separate serverless invocations, so
# without this every trip re-pays for verifying the same well-known
# landmarks every other trip to the same city also selects. When UNSET,
# generation still works exactly as before this cache existed — every
# verification just always calls Google fresh. Setup: Vercel Dashboard ->
# Storage -> Create Database -> Upstash for Redis -> connect to this
# project; these two values are auto-filled by that integration (Settings ->
# Environment Variables -> Show secret). NEVER prefix with VITE_.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Server-side only — read by api/admin/usage.ts. Gates the admin usage
# dashboard (src/pages/AdminUsagePage.vue at /admin/usage): the browser sends
# this back as the X-Admin-Secret header, checked with a constant-time
# compare. UNSET means the endpoint refuses all requests (500) rather than
# running unprotected. Not a real account/auth system — just a shared secret,
# same spirit as this app's other admin-adjacent tokens. NEVER prefix with
# VITE_. Pick any long random string.
ADMIN_DASHBOARD_SECRET=